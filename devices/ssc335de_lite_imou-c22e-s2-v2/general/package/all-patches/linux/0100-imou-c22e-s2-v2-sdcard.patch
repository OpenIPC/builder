-#define PADMUX_SET          (PADMUX_SET_BY_FUNC)
-#define GPIO_SET            (GPIO_SET_BY_FUNC)
+#define PADMUX_SET          (PADMUX_SET_BY_REG)
+#define GPIO_SET            (GPIO_SET_BY_REG)
 
-#define FORCE_SWITCH_PAD    (FALSE)
