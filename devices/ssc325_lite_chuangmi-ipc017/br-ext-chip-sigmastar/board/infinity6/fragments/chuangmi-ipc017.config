# The ipc017 keeps its vendor U-Boot, whose bootargs carry neither panic= nor
# mtdparts=, so append both. Without mtdparts= the kernel falls back to the
# vendor MXP table (BOOT, KERNEL, ROOTFS, DATA, CONFIG, FACTORY). These keep its
# offsets under OpenIPC's names, so /init and sysupgrade find rootfs_data,
# kernel and rootfs, and turn the last 64 KB of the vendor DATA partition into
# an env of its own: the vendor environment shares its erase block with the end
# of U-Boot and must not be written.
CONFIG_CMDLINE="mtdparts=NOR_FLASH:320k(boot)ro,2048k(kernel),7552k(rootfs),6272k(rootfs_data),64k(env),64k(config)ro,64k(factory)ro panic=20"
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_CMDLINE_EXTEND=y
