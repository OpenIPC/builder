#!/bin/sh
#
# Quectel EC200A-EU (2c7c:6005) on the Zenointel SD-2N-4G, brought up as a second
# link next to Ethernet: RNDIS usb0 with its default route at metric 100, so eth0
# keeps the traffic while it has a route and the modem carries it when it has not.
#
# fw_setenv modem_apn <apn>   APN for the data call (optional: without it the
#                             network's default bearer is used, which is what
#                             most SIMs need)
# fw_setenv modem off         leave the modem powered down
#
# Registering is not enough for usb0 to carry anything: the EC200A attaches
# and holds a bearer on its own, but its DHCP server on usb0 stays silent until
# AT+QNETDEVCTL ties that bearer to the RNDIS interface. So the connect is sent
# whether or not an APN is set.

AT_IFACE=1-1:1.3	# the AT port; 1.2 and 1.4 are the modem's debug ports
AT_LOCK=/var/lock/modem-at	# held around every exchange; majestic reads the port too
PIDFILE=/var/run/udhcpc.usb0.pid
WORKER=/var/run/modem.worker.pid	# the background bring-up, then the DNS monitor
SCRIPT=/usr/share/openipc/modem.udhcpc

power_on() {
	# The stock firmware's sequence for this modem (cfgshow wireless type 18):
	# supply 22, PWRKEY 29, USB VBUS 20 on; then PWRKEY and RESET 30 low; then
	# PWRKEY released.
	gpio set 22
	gpio set 29
	gpio set 20
	usleep 500000
	gpio clear 29
	gpio clear 30
	usleep 500000
	gpio set 29
}

at_port() {
	for t in /sys/bus/usb/devices/$AT_IFACE/ttyUSB*; do
		[ -e "$t" ] && echo /dev/${t##*/} && return 0
	done
	return 1
}

# at <command> [seconds]: send one command and print the reply. The port is
# opened read-write once, so the reply cannot arrive before anything is
# listening for it.
at() {
	port=$(at_port) || return 1
	(
		flock 9
		stty -F "$port" 115200 raw -echo 2>/dev/null
		{
			printf '%s\r\n' "$1" >&3
			# timeout ends the read; its "Terminated" is not news.
			timeout "${2:-1}" cat <&3 2>/dev/null
		} 3<>"$port" | tr -d '\r'
	) 9>$AT_LOCK
}

registered() {
	at "AT+CEREG?" | grep -q '^+CEREG: [0-9],[15]'
}

connect() {
	at "AT+QNETDEVCTL=1,1,1" 3 | grep -q '^OK'
}

# The tie between the bearer and usb0 does not survive the cell: after a
# re-registration the modem holds a new bearer, with a new address, and leaves
# it unconnected, while udhcpc sits on the old lease for the rest of its day.
# Measured on the SD-2N-4G across an AT+CFUN=4/1 cycle. So the worker checks,
# and when the modem is registered but not connected, connects it again and
# has udhcpc drop the dead lease and ask for the new one.
heal() {
	st=$(at "AT+QNETDEVCTL?" | sed -n 's/^+QNETDEVCTL: [0-9]*,[0-9]*,[0-9]*,\([0-9]*\).*/\1/p')
	[ "$st" = 0 ] || return 0	# connected, or the modem did not answer
	registered || return 0
	logger -t modem "usb0 lost its data session; reconnecting"
	connect || return 0
	[ -f $PIDFILE ] || return 0
	kill -USR2 "$(cat $PIDFILE)" 2>/dev/null	# release
	kill -USR1 "$(cat $PIDFILE)" 2>/dev/null	# and ask again
}

start() {
	[ "$(fw_printenv -n modem 2>/dev/null)" = "off" ] && return 0
	echo "Starting 4G modem..."
	# rndis_host first: loaded after it, the generic serial driver would claim the
	# RNDIS data interface too, and usb0 would never appear.
	modprobe rndis_host
	modprobe usbserial vendor=0x2c7c product=0x6005
	power_on
	(
		n=0
		while [ $n -lt 40 ] && ! ip link show usb0 >/dev/null 2>&1; do
			sleep 1
			n=$((n + 1))
		done
		if ! ip link show usb0 >/dev/null 2>&1; then
			logger -t modem "EC200A did not enumerate"
			exit 1
		fi
		apn=$(fw_printenv -n modem_apn 2>/dev/null)
		[ -n "$apn" ] && at "AT+QICSGP=1,1,\"$apn\",\"\",\"\",1" >/dev/null
		n=0
		while [ $n -lt 60 ] && ! registered; do
			sleep 2
			n=$((n + 2))
		done
		registered || logger -t modem "not registered after 60 s, connecting anyway"
		connect || logger -t modem "the modem refused to connect usb0"
		# A cable that comes out should not leave a dead eth0 default route
		# winning over the modem's.
		echo 1 > /proc/sys/net/ipv4/conf/eth0/ignore_routes_with_linkdown 2>/dev/null
		ip link set usb0 up
		udhcpc -i usb0 -b -S -p $PIDFILE -s $SCRIPT
		# Which link's DNS is in force follows eth0, and eth0's link coming
		# and going raises nothing a lease script would see. Every third
		# pass also checks that usb0 still has its data session.
		i=0
		while :; do
			sleep 10
			$SCRIPT sync
			i=$((i + 1))
			[ $((i % 3)) -eq 0 ] && heal
		done
	) &
	echo $! > $WORKER
}

stop() {
	# The worker first: stopped during the enumeration wait, it would
	# otherwise go on to start DHCP after this has finished.
	[ -f $WORKER ] && kill "$(cat $WORKER)" 2>/dev/null
	rm -f $WORKER
	[ -f $PIDFILE ] && kill "$(cat $PIDFILE)" 2>/dev/null
	rm -f $PIDFILE
	# Address and routes too: the modem stays powered across a restart, so
	# usb0 outlives it, and a lease left on it reads as a link that is up.
	ip route flush dev usb0 2>/dev/null
	ip -4 addr flush dev usb0 2>/dev/null
	ip link set usb0 down 2>/dev/null
	rm -f /var/run/modem.dns
	$SCRIPT sync
}

case "$1" in
	start|stop)
		$1
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
