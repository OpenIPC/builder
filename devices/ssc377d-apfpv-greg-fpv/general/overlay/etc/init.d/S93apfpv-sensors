#!/bin/sh

case "$1" in
    start)
        set -e
        if command -v base64 >/dev/null 2>&1 && command -v gzip >/dev/null 2>&1; then
            for name in imx335_greg_fpv imx335_milos6; do
                src="/etc/sensors/$name.bin.gz.b64"
                dst="/etc/sensors/$name.bin"
                if [ -f "$src" ] && [ ! -f "$dst" ]; then
                    base64 -d "$src" | gzip -dc > "$dst"
                    chmod 0644 "$dst"
                fi
            done
        fi
        ;;
esac
