diff --git a/src/gc6153_calc.c b/src/gc6153_calc.c
new file mode 100644
index 0000000..4bb532a
--- /dev/null
+++ b/src/gc6153_calc.c
@@ -0,0 +1,225 @@
+// The gc6153 backend's pure logic: the board config parser, verb -> axis, the
+// speed mapping and the soft-limit clamp. No device, no thread, no HAL seam.
+
+#include "act_gc6153.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+void gc_config_defaults(GcConfig *c) {
+    // The Vstarcam C8622 (T23), the board this was written on: the vendor
+    // HwCfg's HMotor MaxStep 15000 / VMotor MaxStep 2000, direction 1 turning
+    // the head left and up, and the vendor driver's own top rate.
+    c->travel[GC_PAN] = 15000;
+    c->travel[GC_TILT] = 2000;
+    c->left_sign = 1;
+    c->up_sign = 1;
+    c->speed = 10;
+    c->home_speed = 5;
+    c->step_us = 1000;
+    c->chunk = 1023;        // the most one burst can run (10-bit count)
+    c->diag_chunk = 128;
+    c->home = true;
+    c->frame_steps[GC_PAN] = 0;
+    c->frame_steps[GC_TILT] = 0;
+    c->scl = 53;            // PB21
+    c->sda = 52;            // PB20
+    c->ircut_watch = 61;    // PB29, majestic's nightMode.backlightPin
+}
+
+static bool parse_int(const char *s, long lo, long hi, long *out) {
+    char *end;
+    long v = strtol(s, &end, 10);
+    while (*end && isspace((unsigned char)*end)) {
+        end++;
+    }
+    if (end == s || *end || v < lo || v > hi) {
+        return false;
+    }
+    *out = v;
+    return true;
+}
+
+bool gc_config_line(GcConfig *c, const char *line) {
+    while (*line && isspace((unsigned char)*line)) {
+        line++;
+    }
+    if (!*line || *line == '#') {
+        return true;
+    }
+    const char *eq = strchr(line, '=');
+    if (!eq) {
+        return false;
+    }
+    size_t klen = (size_t)(eq - line);
+    while (klen && isspace((unsigned char)line[klen - 1])) {
+        klen--;
+    }
+    const char *val = eq + 1;
+    while (*val && isspace((unsigned char)*val)) {
+        val++;
+    }
+
+    static const struct {
+        const char *key;
+        long lo, hi;
+    } keys[] = {
+        {"pan_travel", 0, 200000},  {"tilt_travel", 0, 200000},
+        {"pan_left", -1, 1},        {"tilt_up", -1, 1},
+        {"speed", 1, 10},           {"home_speed", 1, 10},
+        {"step_us", 100, 20000},
+        {"chunk", 1, 1023},         {"diag_chunk", 1, 1023},
+        {"home", 0, 1},
+        {"pan_frame_steps", 0, 2 * PTZ_STEPS_MAX},
+        {"tilt_frame_steps", 0, 2 * PTZ_STEPS_MAX},
+        {"scl", 0, 127},            {"sda", 0, 127},
+        {"ircut_watch", -1, 127},
+    };
+    for (size_t i = 0; i < sizeof keys / sizeof *keys; i++) {
+        if (strlen(keys[i].key) != klen || strncmp(keys[i].key, line, klen)) {
+            continue;
+        }
+        long v;
+        if (!parse_int(val, keys[i].lo, keys[i].hi, &v)) {
+            return false;
+        }
+        switch (i) {
+        case 0: c->travel[GC_PAN] = (int)v; break;
+        case 1: c->travel[GC_TILT] = (int)v; break;
+        case 2:
+            if (!v) return false;   // a sign, so +1 or -1, never 0
+            c->left_sign = (int)v;
+            break;
+        case 3:
+            if (!v) return false;
+            c->up_sign = (int)v;
+            break;
+        case 4: c->speed = (int)v; break;
+        case 5: c->home_speed = (int)v; break;
+        case 6: c->step_us = (int)v; break;
+        case 7: c->chunk = (int)v; break;
+        case 8: c->diag_chunk = (int)v; break;
+        case 9: c->home = v != 0; break;
+        case 10: c->frame_steps[GC_PAN] = (int)v; break;
+        case 11: c->frame_steps[GC_TILT] = (int)v; break;
+        case 12: c->scl = (int)v; break;
+        case 13: c->sda = (int)v; break;
+        case 14: c->ircut_watch = (int)v; break;
+        }
+        return true;
+    }
+    return false;
+}
+
+int gc_chip_speed(const GcConfig *c, int speed) {
+    if (speed <= 0 || speed >= 63) {
+        return c->speed;
+    }
+    // 1..62 over the chip's 1..10, never below its slowest.
+    int cs = 1 + (speed - 1) * 9 / 62;
+    if (cs > c->speed) {
+        cs = c->speed;   // the configured rate stays the ceiling
+    }
+    return cs;
+}
+
+int gc_period(const GcConfig *c, int chip_speed) {
+    (void)c;
+    if (chip_speed < 1) {
+        chip_speed = 1;
+    } else if (chip_speed > 10) {
+        chip_speed = 10;
+    }
+    return 215 + 30 * (10 - chip_speed);
+}
+
+long gc_burst_ms(const GcConfig *c, int steps, int chip_speed) {
+    // step_us is calibrated at the chip's speed 10 (period 245); the run
+    // stretches with the period. Rounded up: a deadline set from this must
+    // never expire while the chip is still stepping. The product overflows
+    // 32-bit long at the slow end of the config range (1023 * 20000 * 515),
+    // so it is taken in 64-bit; after the /245 the result fits a long.
+    long long us = (long long)steps * c->step_us * gc_period(c, chip_speed) / 245;
+    return (long)((us + 999) / 1000);
+}
+
+bool gc_verb_dirs(const GcConfig *c, enum PtzVerb v, int dir[GC_AXES]) {
+    int pan, tilt;
+    if (!ptz_verb_dirs(v, &pan, &tilt)) {
+        return false;
+    }
+    // ptz_verb_dirs says right and up are +1; the board says which raw sign
+    // turns the head left and which up.
+    dir[GC_PAN] = pan * -c->left_sign;
+    dir[GC_TILT] = tilt * c->up_sign;
+    return true;
+}
+
+void gc_arm_axes(const int dir[GC_AXES], int steps, int speed, int cur_dir[GC_AXES],
+                 int cur_left[GC_AXES], int cur_speed[GC_AXES], bool armed[GC_AXES]) {
+    for (int a = 0; a < GC_AXES; a++) {
+        armed[a] = false;
+        if (!dir[a] && steps > 0 && cur_dir[a] && cur_left[a] > 0) {
+            continue;   // that axis's own count goes on, at its own speed
+        }
+        cur_dir[a] = dir[a];
+        cur_left[a] = dir[a] ? steps : -1;
+        if (dir[a]) {
+            cur_speed[a] = speed;
+        }
+        armed[a] = dir[a] != 0;
+    }
+}
+
+int gc_next_axis(const int dir[GC_AXES], int last) {
+    bool pan = dir[GC_PAN] != 0, tilt = dir[GC_TILT] != 0;
+    if (pan && tilt) {
+        return last == GC_PAN ? GC_TILT : GC_PAN;
+    }
+    return pan ? GC_PAN : tilt ? GC_TILT : -1;
+}
+
+double gc_norm_pos(const GcConfig *c, int axis, int pos) {
+    int travel = c->travel[axis];
+    if (travel <= 0) {
+        return 0.0;
+    }
+    double u = 2.0 * pos / travel - 1.0;   // -1 at raw 0, 1 at the far stop
+    if (u < -1.0) {
+        u = -1.0;
+    } else if (u > 1.0) {
+        u = 1.0;
+    }
+    return axis == GC_PAN ? u * -c->left_sign : u * c->up_sign;
+}
+
+int gc_parse_pos(const GcConfig *c, const char *line, int pos[GC_AXES],
+                 bool known[GC_AXES]) {
+    int v[GC_AXES];
+    int n = 0;
+    bool parsed = sscanf(line, "%d %d", &v[GC_PAN], &v[GC_TILT]) == 2;
+    for (int a = 0; a < GC_AXES; a++) {
+        known[a] = parsed && c->travel[a] > 0 && v[a] >= 0 && v[a] <= c->travel[a];
+        if (known[a]) {
+            pos[a] = v[a];
+            n++;
+        }
+    }
+    return n;
+}
+
+int gc_clamp_step(int pos, int dir, int want, int travel) {
+    if (want <= 0) {
+        return 0;
+    }
+    if (travel <= 0) {
+        return want;
+    }
+    int room = dir > 0 ? travel - pos : pos;
+    if (room <= 0) {
+        return 0;
+    }
+    return want < room ? want : room;
+}
