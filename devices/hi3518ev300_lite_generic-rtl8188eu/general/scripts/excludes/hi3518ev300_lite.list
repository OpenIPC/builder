#
# This build drives an RTL8188EU dongle through rtl8188eus-openipc, which talks
# cfg80211 directly. So the MT7601U driver goes, its near-incompressible
# firmware blob goes, and mac80211 goes with them -- modules.dep shows mt7601u
# is the only module that ever needed it, and nothing else in the image does.
#
/lib/modules/4.9.37/kernel/drivers/net/wireless/mediatek/mt7601u/mt7601u.ko
/lib/firmware/mediatek/mt7601u.bin
/lib/modules/4.9.37/kernel/net/mac80211/mac80211.ko
