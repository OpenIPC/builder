#!/bin/sh
# Divinus streamer on the Imou LOOC 2 (SigmaStar infinity3).
DAEMON=/usr/bin/divinus
PIDFILE=/var/run/divinus.pid

start() {
	echo -n "Starting divinus: "
	# load_mstar pins the splitter buffers at 640x480 and then turns
	# reallocation off; the 1280x720 snapshot channel needs them to grow.
	echo 1 > /sys/class/mstar/msys/dmem_realloc 2>/dev/null
	cd /etc
	start-stop-daemon -S -b -m -q -p "$PIDFILE" -x "$DAEMON" && echo OK || echo FAIL
}

stop() {
	echo -n "Stopping divinus: "
	start-stop-daemon -K -q -p "$PIDFILE" && echo OK || echo FAIL
	rm -f "$PIDFILE"
	# The streamer needs a few seconds to release the sensor and its ports;
	# a start before that leaves the new one without them.
	n=0
	while pidof divinus > /dev/null; do
		n=$((n + 1))
		[ $n -eq 10 ] && killall -q -9 divinus
		[ $n -gt 12 ] && break
		sleep 1
	done
}

case "$1" in
	start|stop) $1 ;;
	restart|reload) stop; sleep 2; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
