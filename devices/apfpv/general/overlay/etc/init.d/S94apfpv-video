#!/bin/sh

case "$1" in
	start)
		if command -v cli >/dev/null 2>&1; then
			# APFPV test profile: single H.265 main stream at 1280x720/30.
			cli -s .video0.enabled true
			cli -s .video0.codec h265
			cli -s .video0.size 1280x720
			cli -s .video0.fps 30
			# Keep the secondary H.264 stream disabled for this test.
			cli -s .video1.enabled false
		fi
		;;
esac
