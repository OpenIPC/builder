# The HM202's antenna sits badly for some head positions and the RTL8188FU
# driver never leaves an access point on its own, so a camera can stay on a
# far one after a dropout: let wpa_supplicant scan below -60 dBm and roam.
# A copy of OpenIPC/firmware's general/overlay/etc/network/interfaces.d/wlan0
# with the bgscan line added; keep it in step with that file.
iface wlan0 inet dhcp
    pre-up wlan_conf "$(fw_printenv -n wlanssid)" "$(fw_printenv -n wlanpass)" > /tmp/wpa_supplicant.conf
    pre-up sed -i 's/^\tscan_ssid=1$/\tscan_ssid=1\n\tbgscan="simple:30:-60:300"/' /tmp/wpa_supplicant.conf
    pre-up wpa_supplicant -B -i wlan0 -D nl80211,wext -c /tmp/wpa_supplicant.conf
    post-down killall -q wpa_supplicant
