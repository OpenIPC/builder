Subject: [PATCH] ARM: dts: configure Baseus P1 Pro S0TV022132

Set the board GPIO and pinmux, configure microSD, and disable Ethernet.

--- a/arch/arm/boot/dts/ak3918av100x-demb.dts
+++ b/arch/arm/boot/dts/ak3918av100x-demb.dts
@@ -16,3 +16,58 @@
 		bootargs = "console=ttySAK0,115200n8 root=/dev/mtdblock3 rootfstype=squashfs init=/init mem=128M memsize=128M mtdparts=spi0.0:256k(boot),64k(env),2048k(kernel),5120k(rootfs),-(rootfs_data)";
 	};
 };
+
+/* Baseus SC5336 board wiring and USB radio power pin. */
+&sensor0 {
+	reset-gpio = <&gpio XGPIO_023 1>;
+	pwdn-gpio = <&gpio 0xffff 1>;
+};
+
+&i2c0_pins {
+	anyka,pins = <XGPIO_020 XGPIO_021>;
+	anyka,function = <XGPIO_020_FUNC_TWI0_SDA XGPIO_021_FUNC_TWI0_SCL>;
+};
+
+&mmc2 {
+	status = "disabled";
+};
+
+/* The Baseus microSD slot is wired for a single data lane. */
+&mci1_pins {
+	anyka,pins = <XGPIO_035 XGPIO_034 XGPIO_033>;
+	anyka,function = <XGPIO_035_FUNC_SDIO0_DATA0
+			  XGPIO_034_FUNC_SDIO0_MCLK
+			  XGPIO_033_FUNC_SDIO0_CMD>;
+	anyka,pull = <0x1010010>;
+};
+
+&mci1_idle_pins {
+	anyka,pins = <XGPIO_035 XGPIO_034 XGPIO_033>;
+	anyka,function = <XGPIO_035_FUNC_GPIO35 XGPIO_034_FUNC_GPIO34
+			  XGPIO_033_FUNC_GPIO33>;
+	anyka,pull = <0>;
+};
+
+&mmc1 {
+	bus-width = <1>;
+	pinctrl-0 = <&mci1_pins>, <&tf_det_pins>;
+	/delete-property/ power-pins;
+	/delete-property/ power-inverted;
+};
+
+&gpiokeys {
+	config {
+		gpios = <&gpio XGPIO_003 GPIO_ACTIVE_LOW>;
+	};
+};
+
+/* Release the shared pad so Majestic can drive the IR illuminator. */
+&saradc {
+	/delete-property/ pinctrl-0;
+	/delete-property/ pinctrl-names;
+};
+
+/* This board has no populated Ethernet interface. */
+&ethernet {
+	status = "disabled";
+};
