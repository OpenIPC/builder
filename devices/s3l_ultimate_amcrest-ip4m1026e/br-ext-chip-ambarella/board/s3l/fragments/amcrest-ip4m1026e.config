# 32 MB W25Q256JV on the SPI-NOR controller; s3l.generic.config is set up for SPI-NAND.
CONFIG_MTD_AMBARELLA_SPI_NOR=y
CONFIG_MTD_BLOCK=y

# The Dahua U-Boot passes ATAGs, not a device tree: the uImage carries the board DTB.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_AMBARELLA_OPENIPC_DTB="ambarella-s3l-ip4m1026e"

# The Dahua U-Boot passes its own command line in ATAGs, which an appended-DTB kernel ignores,
# and the board DTS sets no bootargs, so this is the command line. The layout keeps the Dahua
# boot area as it is: MinBoot, U-Boot and the DTB it loads (boot), its environment (env) and the
# table its U-Boot reads at 0xe0000 (partition). The kernel starts where the stock one does,
# 0xf0000, where U-Boot's bootcmd reads it from. rootfs_data ends at 0x1a70000 and the flash after it stays
# stock (dahua): the Dahua U-Boot writes a boot-state record (state, err_count) into the stock updateflag
# partition there on every boot.
CONFIG_CMDLINE="console=ttyS0,115200 panic=20 root=/dev/mtdblock4 rootfstype=squashfs init=/init mtdparts=amba_spinor:768k(boot)ro,128k(env),64k(partition)ro,2048k(kernel),8192k(rootfs),15872k(rootfs_data),-(dahua)ro"
