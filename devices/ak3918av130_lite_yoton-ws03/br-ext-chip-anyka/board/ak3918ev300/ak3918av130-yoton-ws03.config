# atbm606x-openipc builds its own cfg80211.ko, the same name and exports as
# the kernel's, so the kernel's are off.
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# That cfg80211 still calls the kernel's wireless-extensions core
# (wireless_send_event), and WIRELESS_EXT is a hidden symbol only a driver
# can select. R8712U is the one on this kernel that does not need CFG80211;
# its module is dropped from the image by the excludes list.
CONFIG_R8712U=m
